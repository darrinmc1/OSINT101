# Clerk (auth). Free sign-up and sign-in.
# Create a Clerk application, then paste the keys into Vercel env (Preview and Production).
# Do not commit the values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/modules
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/modules

# Supabase (database). Server writes use the service role. Never prefix it with NEXT_PUBLIC_.
# Run supabase/migrations/20261115000000_accounts_usage.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails that may open /admin/usage. Must match the Clerk account email.
ADMIN_EMAILS=

# Optional. Page-view analytics only. Leave unset to keep Google Analytics off.
NEXT_PUBLIC_GA_ID=

# Existing mail and capture. Leave unset until those services should send.
RESEND_API_KEY=
RESEND_FROM=
NOTIFY_EMAIL=
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
SITE_KEY=osint101

# Payments stay off. Do not add Stripe keys on this branch.
