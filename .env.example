# Case File planner. Live AI uses OpenRouter. If OPENROUTER_API_KEY is unset,
# POST /api/case-file still returns a catalog plan (engine: catalog, aiAvailable: false).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Site
NEXT_PUBLIC_SITE_NAME=OSINT 101
NEXT_PUBLIC_GA_ID=
SITE_KEY=

# Auth (Clerk). Advanced Case File steps stay gated until both keys are set.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase
# ── Clerk (auth) ──────────────────────────────────────────────────────────────

# ── Supabase (entitlements) ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email
RESEND_API_KEY=
# ── Stripe (TTPN test mode — leave both flags false until Preview is checked) ──
# Server gate. POST /api/checkout and POST /api/stripe/webhook return 503 unless this is the string true.
STRIPE_ENABLED=false
# Baked into the client at build time. Buy buttons stay "Coming soon" unless this is the string true.
# A product with available: false stays "Coming soon" even when this is true.
NEXT_PUBLIC_STRIPE_ENABLED=false
# TTPN test secret (sk_test_…). Never commit the value. Do not print it.
STRIPE_SECRET_KEY=
# Signing secret for this site's test webhook endpoint. Never commit the value.
STRIPE_WEBHOOK_SECRET=
# Lookup-key prefix. Code builds osint101_founding_m_usd5, osint101_founding_y_usd48,
# osint101_analyst_m_usd19, and osint101_analyst_y_usd180. Currency is usd.
STRIPE_SITE_KEY=osint101
# Prebuilt Checkout does not need a publishable key. Leave blank unless a client SDK is added.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Launch offer (50% off the first billing period) ───────────────────────────
# YYYY-MM-DD. Active through 23:59:59 that day in Australia/Brisbane (UTC+10).
# Default end: 2026-12-18T23:59:59+10:00. Copy and checkout share one check.
# After that instant the banner hides and checkout stops attaching the coupon.
# Extend by changing the date. Stripe redeem_by cannot be edited, so a longer run
# needs a new coupon or promotion code as well.
LAUNCH_OFFER_ENDS=2026-12-18
# Coupon id, or a promotion code id that starts with promo_.
# Create the coupon in Stripe test mode with duration "once" (first period only).
# This app does not create the coupon. Leave blank to charge the list price.
STRIPE_LAUNCH_COUPON_ID=

# ── Resend (transactional email) ──────────────────────────────────────────────
# Verified Resend sender. Do not use an @example.com placeholder.
RESEND_FROM=
RESEND_REPLY_TO=
NOTIFY_EMAIL=

# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SITE_TAG=
# ── Site ──────────────────────────────────────────────────────────────────────
# Public support address for the buy line. Leave unset to omit it.
NEXT_PUBLIC_SUPPORT_EMAIL=
