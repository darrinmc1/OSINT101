# Case File planner. Live AI uses OpenRouter. If OPENROUTER_API_KEY is unset,
# POST /api/case-file still returns a catalog plan (engine: catalog, aiAvailable: false).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Site
NEXT_PUBLIC_SITE_NAME=OSINT 101
NEXT_PUBLIC_GA_ID=
SITE_KEY=

# Auth (Clerk). Copy the existing Production keys into Preview if the
# sign-up form should render there. Do not invent keys.
# In the Clerk dashboard, allow the preview hostname.
# ADMIN_EMAILS is a comma-separated list of Clerk emails allowed to open /admin/usage.
ADMIN_EMAILS=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase. Usage logging needs the SQL in
# supabase/migrations/20261118000000_accounts_usage.sql run in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
NOTIFY_EMAIL=

# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SITE_TAG=

# n8n feedback webhook shared secret (server-only; never NEXT_PUBLIC_).
# Sent as X-KD7-Secret after a feedback save. If unset, the webhook is still
# called without the header.
KD7_WEBHOOK_SECRET=
